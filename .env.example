# Copy to .env and adjust. Every value is optional: the defaults run the offline demo.
# Never commit .env. AWS credentials are NOT configured here; use the standard AWS credential
# chain (AWS_PROFILE, SSO, instance/task role).

# --- corpus and index
DPKA_CORPUS_DIR=data/corpus
DPKA_INDEX_PATH=.dpka/index.sqlite

# --- embeddings: fastembed (open-source model, local) | hashing (tests/CI only, not semantic)
DPKA_EMBEDDING_BACKEND=fastembed
DPKA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- retrieval: hybrid (dense + BM25, reciprocal rank fusion) | dense
DPKA_RETRIEVAL_MODE=hybrid
DPKA_TOP_K=5
# abstention gate; re-calibrate if you change the embedding model or corpus
DPKA_MIN_RELEVANCE=0.68
DPKA_MIN_COVERAGE=0.3

# --- answer provider: offline (extractive, no LLM, free) | bedrock (paid, needs AWS access)
DPKA_LLM_PROVIDER=offline
# Required when DPKA_LLM_PROVIDER=bedrock. Any model that supports the Bedrock Converse API and
# is enabled in your account: a base model ID, an inference profile ID (for example the
# cross-Region "us." / "eu." profiles) or an inference profile / provisioned model ARN.
# Copy the exact value from the Bedrock console or `aws bedrock list-inference-profiles`.
DPKA_BEDROCK_MODEL_ID=
# Optional. Not sent unless set; supported sampling parameters differ by model.
# DPKA_LLM_TEMPERATURE=0
DPKA_AWS_REGION=us-east-1
DPKA_LLM_TIMEOUT_S=30
DPKA_LLM_MAX_RETRIES=2
DPKA_LLM_MAX_TOKENS=1024
